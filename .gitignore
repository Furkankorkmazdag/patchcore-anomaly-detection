# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local videos and image datasets (large / potentially sensitive files)
videos/*
!videos/.gitkeep
dataset/train/normal/*
!dataset/train/normal/.gitkeep
dataset/test/normal/*
!dataset/test/normal/.gitkeep
dataset/test/anomaly/*
!dataset/test/anomaly/.gitkeep

# Training runs, checkpoints, exports, and generated analysis
results/*
!results/.gitkeep
*.ckpt
*.pt
*.pth
*.onnx
*.xml
*.bin

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
